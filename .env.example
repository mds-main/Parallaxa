# Names only. Never commit values. In production set them with `vercel env add`.

# Database: Neon Postgres (EU). Leave empty locally to use the embedded PGlite database in .data/.
DATABASE_URL=
# Optional: direct connection for migrations (the Neon integration sets it), and a backup branch before production migrations.
DATABASE_URL_UNPOOLED=
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
# Optional: auto (default) | apply | check. See docs/deployment.md, "Database migrations".
MIGRATIONS=

# AI providers. Without VENICE_API_KEY the app runs in clearly labelled demo mode (simulated AI).
VENICE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional secondary search API used by the investigation harness (Brave Search API).
# Search engines for investigations (order set in Admin › Investigation › Search engines). Without either, Venice search is used.
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Admin console (F8). Password must be at least 20 characters or the admin site stays disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional comma-separated list of allowed client IPs for /admin.
ADMIN_IP_ALLOWLIST=

# Edge Config (fast config reads) and a Vercel API token scoped to that store (admin publishes).
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=

# Admin alerts go to Telegram (no email anywhere). Bot from BotFather; chat id via `pnpm telegram --find-chats`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server log threshold: debug | info (default) | warn | error
LOG_LEVEL=

# Cron protection (Vercel sends this as a Bearer token).
CRON_SECRET=

# Public site URL used in feeds, manifests and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application-level encryption key (32 random bytes, base64): `openssl rand -base64 32`.
DATA_ENCRYPTION_KEY=

# Web Push (VAPID). Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.org

# Optional passkey accounts (sync across devices). Disabled unless USER_SESSION_SECRET is at least 32 characters.
USER_SESSION_SECRET=
