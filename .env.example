# Names only. Never commit values. In production set them with `vercel env add`.

# Database: Neon Postgres (EU). Leave empty locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# AI providers. Without VENICE_API_KEY the app runs in clearly labelled demo mode (simulated AI).
VENICE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional secondary search API used by the investigation harness (Brave Search API).
BRAVE_SEARCH_API_KEY=

# Admin console (F8). Password must be at least 20 characters or the admin site stays disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional comma-separated list of allowed client IPs for /admin.
ADMIN_IP_ALLOWLIST=

# Edge Config (fast config reads) and a Vercel API token scoped to that store (admin publishes).
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=

# Email (Resend, EU region) for alerts and magic links.
RESEND_API_KEY=
ALERT_EMAIL_TO=

# Cron protection (Vercel sends this as a Bearer token).
CRON_SECRET=

# Public site URL used in feeds, manifests and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
