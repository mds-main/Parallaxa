{
  "name": "parallaxa",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "eval": "tsx scripts/eval.ts",
    "check:all": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm db:check && pnpm test",
    "check:secrets": "tsx scripts/check-client-secrets.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "db:check": "tsx scripts/db-migrate.ts --check",
    "verify": "pnpm check:all && pnpm e2e && pnpm check:secrets",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "telegram": "tsx scripts/telegram.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@neondatabase/serverless": "1.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "1.5.1",
    "@vercel/otel": "^2.3.0",
    "@vercel/speed-insights": "^2.1.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.18",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.1.1"
  }
}
